{
  "name": "review-me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:jsdoc": "node scripts/test-jsdoc.mjs && node scripts/browser-tests.mjs tests/jsdoc-navigation.ts",
    "test:markdown": "node scripts/test-markdown.mjs",
    "test:resolve": "node scripts/test-resolve.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:typecheck": "tsc -p tsconfig.tests.json",
    "test:coverage": "node scripts/browser-tests.mjs tests/coverage.ts",
    "test:algorithms": "node scripts/browser-tests.mjs tests/algorithms.ts",
    "test:navigation": "node scripts/browser-tests.mjs tests/navigation.ts",
    "test:loading": "node scripts/browser-tests.mjs tests/loading.ts",
    "test:keyboard": "node scripts/browser-tests.mjs tests/keyboard.ts",
    "test:review": "node scripts/browser-tests.mjs tests/review.tsx",
    "test:log": "node scripts/browser-tests.mjs tests/log.tsx",
    "test:grep": "node scripts/browser-tests.mjs tests/grep.tsx",
    "test:frontend": "npm run test:typecheck && npm run test:coverage && npm run test:algorithms && npm run test:navigation && npm run test:loading && npm run test:keyboard && npm run test:review && npm run test:log && npm run test:grep && npm run test:jsdoc && npm run test:markdown && npm run test:resolve"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-java": "^6.0.1",
